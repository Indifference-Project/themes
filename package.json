{
  "name": "monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "build:pkg": "pnpm --filter \"@radix-ui/*\" build",
    "dev": "turbo run dev --no-cache --continue",
    "test:vr": "pnpm -r test:vr",
    "test:vr:update": "pnpm -r test:vr:update",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3.8.1",
    "turbo": "^2.3.3",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "string-width": "4.2.3",
      "react-use>js-cookie": "3.0.8",
      "@babel/runtime": "7.29.14",
      "@babel/core": "7.29.6",
      "@humanfs/node": "0.16.8",
      "ajv@6": "6.15.0",
      "ajv@8": "8.18.0",
      "baseline-browser-mapping": "2.11.0",
      "brace-expansion@<2": "1.1.21",
      "browserslist": "4.28.7",
      "colord": "2.9.4",
      "fast-uri": "3.1.9",
      "flatted": "3.4.2",
      "js-yaml": "4.3.2",
      "minimatch@<4": "3.1.4",
      "minimatch@>=7": "11.0.1",
      "picomatch@2": "2.3.2",
      "picomatch@>=3": "4.0.4",
      "postcss-selector-parser@6": "6.1.5",
      "postcss-selector-parser@7": "7.1.6",
      "source-map-js": "1.2.2",
      "turbo": "2.9.14",
      "yaml": "2.8.3",
      "zod": "4.6.6"
    }
  }
}
